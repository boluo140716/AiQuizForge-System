# ===== LLM (OpenAI-compatible) =====
LLM_API_KEY=sk-your-key
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
USE_MOCK=false

# ===== Internal service token =====
# Must match AI_SERVICE_TOKEN in docker-compose.yml
INTERNAL_TOKEN=quizforge-internal-secret-token-2026

# ===== Redis =====
# docker-compose.yml overrides this for the ai-service container.
REDIS_URL=redis://:123456@redis:6379/2
